# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3001

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "gemini" or "ollama"
LLM=gemini

# Google Gemini (required when LLM=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Ollama (required when LLM=ollama)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Node environment (set to "production" in deployment)
NODE_ENV=development

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=edwin-knowledge-base
PINECONE_NAMESPACE=__default__

# ── Firebase (Project ID — shared by client and admin) ────────────────────────
FIREBASE_PROJECT_ID=your_project_id

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
