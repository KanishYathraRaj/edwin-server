# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3001

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "gemini" or "ollama"
LLM=gemini

# Google Gemini (required when LLM=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=edwin-knowledge-base
PINECONE_NAMESPACE=__default__

# ── Firebase (Client SDK — used for Firestore reads/writes) ───────────────────
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ── Firebase Admin SDK (used for verifying user auth tokens) ──────────────────
# Get these from Firebase Console → Project Settings → Service Accounts
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
